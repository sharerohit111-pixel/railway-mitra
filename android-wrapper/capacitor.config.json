{
  "appId": "com.railwaymitra.app",
  "appName": "Railway Mitra",
  "webDir": "web",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": [
        "google.com"
      ]
    },
    "CapacitorUpdater": {
      "autoUpdate": "off",
      "version": "1.0.0",
      "appId": "com.railwaymitra.app",
      "defaultChannel": "production"
    }
  }
}
