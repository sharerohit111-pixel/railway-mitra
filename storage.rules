// IMPORTANT: This file contains the existing Railway Updates PDF and exam-content
// rules plus isolated Test Series private-media deny rules. Before deploying Storage
// rules, export the actual live Firebase Storage rules and reconcile any other live
// feature rules. Do not assume this repository file is the complete live policy.
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Railway Updates PDF library: preserve existing public reads and Owner writes.
    match /updates/{category}/{uid}/{fileName} {
      allow read: if category.matches('^(rbe|pay|exam|transfer|medical|zone|other)$');
      allow write: if category.matches('^(rbe|pay|exam|transfer|medical|zone|other)$')
        && request.auth != null
        && request.auth.token.admin == true
        && request.auth.uid == uid
        && (
          request.resource == null
          || (
            request.resource.size > 0
            && request.resource.size <= 20 * 1024 * 1024
            && request.resource.contentType == 'application/pdf'
          )
        );
    }

    // Test Series private question media: server-authorized signed URL flow only.
    match /test-series-question-media-quarantine/{allPaths=**} {
      allow read, write: if false;
    }
    match /test-series-question-media/{allPaths=**} {
      allow read, write: if false;
    }

    // Existing exam-content access rule; preserve unchanged.
    match /exam-content/{uid}/{folderId}/{fileName} {
      allow read: if request.auth != null && request.auth.token.admin == true && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.token.admin == true && request.auth.uid == uid
        && (request.resource == null || (
          request.resource.size > 0
          && request.resource.size <= 20 * 1024 * 1024
          && request.resource.contentType == 'application/pdf'
        ));
    }
  }
}